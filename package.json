{
  "name": "@prawnwire/node",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the Prawnwire email send API.",
  "keywords": [
    "prawnwire",
    "email",
    "transactional",
    "api",
    "postmark",
    "smtp",
    "typescript"
  ],
  "license": "MIT",
  "author": "Prawnwire",
  "homepage": "https://github.com/prawnwire/prawnwire-node#readme",
  "bugs": {
    "url": "https://github.com/prawnwire/prawnwire-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prawnwire/prawnwire-node.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
